# Local development placeholders only.
#
# Copy to an untracked .env file for local experiments if needed. Do not put real
# secrets, production database URLs, OAuth tokens, provider payloads, production
# paths, or vault contents here.

# Consumed by deploy/docker-compose.yml for local PostgreSQL and host port wiring.
POSTGRES_DB=haze_sync
POSTGRES_USER=haze_sync
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
HAZE_SYNC_HTTP_PORT=8080

# Server config placeholders for host-based local runs. The Compose server service
# overrides these with container paths and its internal PostgreSQL URL.
HAZE_SYNC_DATABASE_URL=
HAZE_SYNC_OBJECT_STORE_PATH=./data/objects
HAZE_SYNC_WORKTREE_PATH=./data/worktree
HAZE_SYNC_LISTEN_ADDR=127.0.0.1:8080
HAZE_SYNC_WORKTREE_ADAPTER_MODE=disabled

# Required only when deploy/docker-compose.worktree.yml is explicitly used.
# Put the real host path in an untracked .env or operator environment. The bind is
# read-only by default. Write-capable modes and write access require explicit
# operator approval plus compatible host ownership and permissions for UID 10001.
HAZE_SYNC_WORKTREE_HOST_PATH=
HAZE_SYNC_WORKTREE_BIND_READ_ONLY=true

# Adapter/client placeholders. No provider credential flow is configured by local compose.
HAZE_GDRIVE_ADAPTER_MODE=disabled
HAZE_GDRIVE_ROOT_FOLDER_ID=
HAZE_OBSIDIAN_ADAPTER_MODE=disabled
HAZE_OBSIDIAN_SERVER_URL=http://127.0.0.1:8080
HAZE_OBSIDIAN_ADAPTER_ID=obsidian-plugin-placeholder

# Required only with deploy/docker-compose.gdrive.yml and profile `gdrive`.
# Secret files must be outside the repository and readable only by the operator.
HAZE_GDRIVE_ADAPTER_ID=gdrive-adapter
HAZE_GDRIVE_ADAPTER_TOKEN_SECRET_FILE=
HAZE_GDRIVE_OAUTH_SECRET_FILE=
HAZE_GDRIVE_MODE=disabled
HAZE_GDRIVE_POLL_INTERVAL_SECONDS=60
HAZE_GDRIVE_FULL_SCAN_INTERVAL_SECONDS=3600
HAZE_GDRIVE_MAX_DELETES_PER_RUN=10
HAZE_GDRIVE_MAX_DELETE_RATIO_PERCENT=10
